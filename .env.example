# Copie este archivo como .env (no se versiona) y ajuste los valores.

# ── PostgreSQL local (docker compose up -d db) ─────────────────────────
POSTGRES_USER=orion
POSTGRES_PASSWORD=orion
POSTGRES_DB=ecoresiduos
POSTGRES_PORT=5432

# ── Backend ────────────────────────────────────────────────────────────
# Local (Docker):
DATABASE_URL=postgresql+psycopg://orion:orion@localhost:5432/ecoresiduos
# Supabase (pooler en modo session, puerto 5432). Copie la cadena desde
# Project Settings → Database → Connection string → Session pooler:
# DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
CORS_ORIGINS=http://localhost:5173

# ── Frontend (Vite solo expone variables que empiezan por VITE_) ───────
VITE_API_URL=http://localhost:8000/api/v1
