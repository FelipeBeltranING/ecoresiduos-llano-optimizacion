# Copie este archivo como .env (no se versiona) y ajuste los valores.

# ── PostgreSQL local (docker compose up -d db) ─────────────────────────
POSTGRES_USER=orion
POSTGRES_PASSWORD=orion
POSTGRES_DB=ecoresiduos
POSTGRES_PORT=5432

# ── Backend ────────────────────────────────────────────────────────────
# Las variables del backend (DATABASE_URL de Supabase, TEST_DATABASE_URL y
# CORS_ORIGINS) van en backend/.env. Ver backend/.env.example.

# ── Frontend (Vite solo expone variables que empiezan por VITE_) ───────
VITE_API_URL=http://localhost:8000/api/v1
